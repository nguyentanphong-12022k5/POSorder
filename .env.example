# ==============================================================================
# POS ORDER & KDS - BIẾN MÔI TRƯỜNG PRODUCTION & DEVELOPMENT TEMPLATE
# Copy file này thành .env hoặc .env.local và điền các giá trị thực tế
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL (Bắt buộc)
# Chuỗi kết nối tới cơ sở dữ liệu Postgres (local, container, hoặc Supabase/Neon/RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/posorder?schema=public"

# 2. Cấu hình Runtime ứng dụng
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# 3. Bảo mật Authentication & JWT (Bắt buộc trên Production - Thay bằng chuỗi ngẫu nhiên >= 32 ký tự)
# Gợi ý tạo: openssl rand -base64 32
JWT_SECRET="pos-production-ultra-secret-key-change-this-now"

# 4. Cấu hình máy in hóa đơn ESC/POS
# PRINTER_MODE:
#   - 'tcp': In trực tiếp qua mạng LAN/Wifi (máy in IP e.g. 192.168.1.100:9100)
#   - 'usb': In qua cổng USB máy tính / POS terminal (/dev/usb/lp0 hoặc COM port)
#   - 'network': In qua router trung gian
PRINTER_MODE="tcp"
PRINTER_IP="192.168.1.100"
PRINTER_PORT=9100
PRINTER_MODEL="Xprinter XP-58 / Epson TM-T82"

# 5. Hệ thống Logging cấu trúc (Pino)
# Các mức độ: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL="info"

# 6. Giám sát lỗi Sentry (Tùy chọn)
# Tạo tài khoản tại https://sentry.io và lấy DSN
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG="pos-order"
SENTRY_PROJECT="pos-drink-order"
SENTRY_AUTH_TOKEN=""

# 7. Supabase Realtime (Tùy chọn cho tính năng đồng bộ Bếp KDS thời gian thực)
# Nếu để trống, hệ thống sẽ tự động dùng cơ chế Smart Polling fallback 3s
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
